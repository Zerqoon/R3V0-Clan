# Required Discord application settings
DISCORD_TOKEN=PASTE_BOT_TOKEN_HERE
CLIENT_ID=PASTE_APPLICATION_ID_HERE
GUILD_ID=PASTE_DISCORD_SERVER_ID_HERE
# Optional: user ID allowed access to protected-owner APIs without a role (leave empty if unused)
OWNER_USER_ID=

# PS99 source — this bot only monitors this clan
PS99_CLAN_NAME=R3V0
# Configured R3V0 founder identity: resolved via Roblox username API and used to reconcile stale/missing Big Games Owner IDs
CLAN_OWNER_FALLBACK_USERNAME=B3STTIEE
CLAN_OWNER_DISPLAY_NAME=Malb0
# Optional but most reliable: numeric Roblox user ID of the R3V0 founder (overrides username resolution).
CLAN_OWNER_ROBLOX_ID=
# Optional. Set only if you know the actual in-game clan kick cooldown duration.
PS99_KICK_COOLDOWN_HOURS=
PS99_API_BASE=https://ps99.biggamesapi.io
PS99_REFRESH_MINUTES=5
PS99_HISTORY_DAYS=8
PS99_RAP_CACHE_HOURS=4

# Provided channel IDs
WELCOME_CHANNEL_ID=1564412964608672070
RULES_CHANNEL_ID=1564413086243233842
LEADERBOARD_CHANNEL_ID=1564416597253165086
GEM_LOG_CHANNEL_ID=1564416615725015094
MESSAGE_LOG_CHANNEL_ID=1564417028159184986
TICKET_PANEL_CHANNEL_ID=1564416280864227359
TICKET_CATEGORY_ID=1564420505132605490
TICKET_LOG_CHANNEL_ID=1564417050439585862
MODERATION_LOG_CHANNEL_ID=1564417071666831431
AUDIT_LOG_CHANNEL_ID=1564417092500062279

# Provided role IDs
OWNER_ROLE_ID=1564414645920596113
OFFICER_ROLE_ID=1564412137881739406
COMMUNITY_ROLE_ID=1564414643655413770
R3V0_ROLE_ID=1564414641768108123
# Optional. You can set this role later through /staff -> Settings.
VERIFIED_ROLE_ID=
# Staff who should be able to view/use tickets; edit if you have a dedicated support role
TICKET_STAFF_ROLE_IDS=1564412137881739406
# Optional extra role IDs allowed to use moderation commands (comma-separated)
MODERATOR_ROLE_IDS=

# PS99 recruitment availability shown in the recruitment panel.
CLAN_SLOTS_CURRENT=20
CLAN_SLOTS_CAPACITY=50

# Allowed external link domains. Discord invite/CDN links are intentionally NOT included.
LINK_ALLOWLIST=giphy.com,klipy.com,tenor.com,roblox.com,rbxcdn.com,tiktok.com,vm.tiktok.com,youtube.com,youtu.be,twitch.tv

# Automatic donation detection uses DiamondContributions.AllTime.Data; no secret is needed.
# Optional: this secret enables authenticated external receipts, which require an eventId.
# Receipts do not add to official totals; the API counter remains authoritative.
GEMS_WEBHOOK_SECRET=

# Runtime
DATA_DIR=/app/data
PORT=3000
NODE_ENV=production
